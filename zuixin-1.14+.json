{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": true,
    "level": "error",
    "timestamp": true
  },
  "ntp": {
    "enabled": true,
    "server": "ntp.aliyun.com",
    "server_port": 123,
    "interval": "30m"
  },
  "http_clients": [
    {
      "tag": "direct-http"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "cloudflare",
        "type": "h3",
        "server": "1.1.1.1",
        "server_port": 443,
        "detour": "proxy",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        }
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "223.5.5.5",
        "server_port": 443,
        "tls": {
          "enabled": true,
          "server_name": "dns.alidns.com"
        }
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "app-measurement.com",
          "hm.baidu.com",
          "firebaselogging.googleapis.com",
          "firebaselogging-pa.googleapis.com",
          "beacons.gvt2.com",
          "beacons2.gvt2.com",
          "beacons3.gvt2.com",
          "tracking.miui.com"
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "server": "ali"
      },
      {
        "clash_mode": "Global",
        "query_type": "A",
        "server": "fakeip"
      },
      {
        "query_type": [
          "HTTPS",
          "AAAA"
        ],
        "action": "reject"
      },
      {
        "rule_set": "geosite/cn",
        "server": "ali"
      },
      {
        "query_type": "A",
        "server": "fakeip"
      }
    ],
    "final": "cloudflare",
    "strategy": "prefer_ipv4",
    "timeout": "5s",
    "cache_capacity": 8192,
    "optimistic": {
      "enabled": true,
      "timeout": "3d"
    }
  },
  "route": {
    "default_http_client": "direct-http",
    "default_domain_resolver": {
      "server": "ali",
      "strategy": "ipv4_only"
    },
    "rules": [
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic",
          "dns"
        ],
        "timeout": "150ms"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "GLOBAL"
      },
      {
        "clash_mode": "Direct",
        "outbound": "direct"
      },
      {
        "rule_set": "geosite/bilibili",
        "outbound": "Bilibili"
      },
      {
        "rule_set": "geosite/openai",
        "outbound": "OpenAI"
      },
      {
        "rule_set": "geosite/cn",
        "outbound": "CN"
      },
      {
        "rule_set": "geoip/cn",
        "outbound": "CN"
      },
      {
        "domain_suffix": [
          "msx.com",
          "mystonks.org"
        ],
        "outbound": "Msx"
      },
      {
        "rule_set": "geosite/netflix",
        "outbound": "Netflix"
      },
      {
        "rule_set": "crypto",
        "outbound": "Crypto"
      },
      {
        "domain_suffix": [
          "okex.org",
          "ouxyi.cash",
          "bitkeep.top",
          "bitget.com"
        ],
        "outbound": "Crypto"
      },
      {
        "rule_set": "geosite/twitter",
        "outbound": "Twitter"
      },
      {
        "rule_set": "geosite/youtube",
        "outbound": "YouTube"
      },
      {
        "rule_set": "geosite/telegram",
        "outbound": "Telegram"
      },
      {
        "rule_set": "geosite/google",
        "outbound": "Google"
      },
      {
        "rule_set": "geosite/apple",
        "outbound": "Apple"
      },
      {
        "rule_set": "geosite/geolocation-!cn",
        "outbound": "proxy"
      },
      {
        "action": "resolve",
        "server": "cloudflare",
        "strategy": "ipv4_only"
      },
      {
        "rule_set": "geoip/netflix",
        "outbound": "Netflix"
      },
      {
        "rule_set": "geoip/telegram",
        "outbound": "Telegram"
      },
      {
        "rule_set": "geoip/google",
        "outbound": "Google"
      },
      {
        "rule_set": "geoip/apple",
        "outbound": "Apple"
      },
      {
        "rule_set": "geoip/cn",
        "outbound": "CN"
      }
    ],
    "rule_set": [
      {
        "tag": [
          "geosite/apple",
          "geosite/bilibili",
          "geosite/cn",
          "geosite/google",
          "geosite/netflix",
          "geosite/telegram",
          "geosite/twitter",
          "geosite/youtube",
          "geoip/apple",
          "geoip/google",
          "geoip/netflix",
          "geoip/telegram"
        ],
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/{tag}.srs",
        "update_interval": "7d"
      },
      {
        "tag": [
          "geoip/cn",
          "geosite/openai",
          "geosite/geolocation-!cn"
        ],
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/{tag}.srs",
        "update_interval": "7d"
      },
      {
        "tag": "crypto",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/senshinya/singbox_ruleset@main/rule/Crypto/Crypto.srs",
        "update_interval": "7d"
      }
    ],
    "final": "final",
    "auto_detect_interface": true
  },
  "outbounds": [
    {
      "tag": "proxy",
      "type": "selector",
      "outbounds": [
        "all-auto",
        "hk",
        "hk-auto",
        "tw",
        "tw-auto",
        "jp",
        "jp-auto",
        "sg",
        "sg-auto",
        "us",
