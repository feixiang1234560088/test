      "interval": "10m",
      "idle_timeout": "30m",
      "tolerance": 100,
      "interrupt_exist_connections": false
    },
    {
      "tag": "GLOBAL",
      "type": "selector",
      "outbounds": [
        "direct",
        "all-auto",
        "hk",
        "hk-auto",
        "tw",
        "tw-auto",
        "jp",
        "jp-auto",
        "sg",
        "sg-auto",
        "us",
        "us-auto",
        "all"
      ],
      "default": "direct",
      "interrupt_exist_connections": false
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "singtun0",
      "address": [
        "172.19.0.1/28"
      ],
      "mtu": 1420,
      "auto_route": true,
      "strict_route": true,
      "udp_timeout": "2m",
      "dns_mode": "hijack",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip",
      "external_ui_download_detour": "proxy"
    },
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    }
  }
