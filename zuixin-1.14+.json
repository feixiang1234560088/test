        "hk-auto",
        "tw",
        "tw-auto",
        "jp",
        "jp-auto",
        "sg",
        "sg-auto",
        "us",
        "us-auto",
        "all"
      ],
      "default": "jp-auto",
      "interrupt_exist_connections": false
    },
    {
      "tag": "OpenAI",
      "type": "selector",
      "outbounds": [
        "us-auto",
        "jp-auto",
        "sg-auto",
        "all-auto",
        "direct",
        "hk",
        "hk-auto",
        "tw",
        "tw-auto",
        "jp",
        "sg",
        "us",
        "all"
      ],
      "default": "jp-auto",
