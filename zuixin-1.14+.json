        "all"
      ],
      "default": "jp-auto",
      "interrupt_exist_connections": false
    },
    {
      "tag": "hk",
      "type": "selector",
      "outbounds": [],
      "interrupt_exist_connections": false
    },
    {
      "tag": "tw",
      "type": "selector",
      "outbounds": [],
