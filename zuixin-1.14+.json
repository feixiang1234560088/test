      "interrupt_exist_connections": false
    },
    {
      "tag": "all",
      "type": "selector",
      "outbounds": [],
      "interrupt_exist_connections": false
    },
    {
      "tag": "hk-auto",
      "type": "urltest",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "10m",
      "idle_timeout": "30m",
      "tolerance": 100,
      "interrupt_exist_connections": false
    },
    {
      "tag": "tw-auto",
      "type": "urltest",
      "outbounds": [],
